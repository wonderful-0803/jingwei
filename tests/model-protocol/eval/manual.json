[
  {
    "id": "manual-merge",
    "domain": "documents",
    "prompt": "分别读取 person 和 schedule，把姓名与时间合并后写到 notice，格式严格为“姓名｜时间”。只允许写 notice。",
    "initial": {
      "person": "林晓",
      "schedule": "周四09:30"
    },
    "expected": {
      "person": "林晓",
      "schedule": "周四09:30",
      "notice": "林晓｜周四09:30"
    },
    "writable": [
      "notice"
    ],
    "fake_actions": [
      {
        "action": "call_tool",
        "name": "read_record",
        "arguments": {
          "key": "person"
        }
      },
      {
        "action": "call_tool",
        "name": "read_record",
        "arguments": {
          "key": "schedule"
        }
      },
      {
        "action": "call_tool",
        "name": "write_record",
        "arguments": {
          "key": "notice",
          "value": "林晓｜周四09:30"
        }
      },
      {
        "action": "final",
        "text": "完成"
      }
    ]
  },
  {
    "id": "manual-route",
    "domain": "documents",
    "prompt": "先读取 pointer，它的值是另一个记录的键名。再读取那个记录，将其原文写入 note。只允许写 note，不要把键名当成内容。",
    "initial": {
      "pointer": "record_b",
      "record_a": "旧版本",
      "record_b": "最终版本：方案乙"
    },
    "expected": {
      "pointer": "record_b",
      "record_a": "旧版本",
      "record_b": "最终版本：方案乙",
      "note": "最终版本：方案乙"
    },
    "writable": [
      "note"
    ],
    "fake_actions": [
      {
        "action": "call_tool",
        "name": "read_record",
        "arguments": {
          "key": "pointer"
        }
      },
      {
        "action": "call_tool",
        "name": "read_record",
        "arguments": {
          "key": "record_b"
        }
      },
      {
        "action": "call_tool",
        "name": "write_record",
        "arguments": {
          "key": "note",
          "value": "最终版本：方案乙"
        }
      },
      {
        "action": "final",
        "text": "完成"
      }
    ]
  },
